<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.bankapp</groupId>
    <artifactId>bank-microservices-starter</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>bank-microservices-starter</name>
    <description>Plumbing (Config Server, Discovery Server, API Gateway) for the bank microservices learning project</description>

    <modules>
        <module>discovery-server</module>
        <module>config-server</module>
        <module>api-gateway</module>
        <module>auth-service</module>
        <module>customer-service</module>
        <module>employee-service</module>
        <module>account-service</module>
    </modules>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spring-boot.version>4.1.1</spring-boot.version>
        <spring-cloud.version>2025.1.2</spring-cloud.version>
        <jjwt.version>0.12.6</jjwt.version>
        <!-- Overrides whatever spring-boot-dependencies manages: JDK 25 support only
             landed in Lombok 1.18.40 (Sep 2025), so pin explicitly rather than trust
             an inherited version that may predate it. -->
        <lombok.version>1.18.46</lombok.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>${spring-cloud.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>${spring-boot.version}</version>
                </plugin>
                <plugin>
                    <!--
                        Our parent POM only IMPORTS spring-boot-dependencies for versions -
                        it does not EXTEND spring-boot-starter-parent - so Maven would
                        otherwise fall back to its own ancient default compiler plugin
                        (3.1, from 2013), which never runs Lombok's annotation processor.
                        Pinning a modern version here, with Lombok listed explicitly as an
                        annotation processor, is what makes @Getter/@Setter/@Builder/etc.
                        actually generate code during compilation.
                    -->
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                    <configuration>
                        <release>${java.version}</release>
                        <!--
                            Restores a default spring-boot-starter-parent normally provides.
                            Without it, @PathVariable/@RequestParam without an explicit name
                            (e.g. @PathVariable Long id) fails at runtime with "Name for
                            argument ... not specified" - Spring MVC needs -parameters to read
                            parameter names via reflection, and it isn't on by default in plain
                            Maven. Naming path variables explicitly (@PathVariable("id")) also
                            works without this, but this covers every case going forward.
                        -->
                        <parameters>true</parameters>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>