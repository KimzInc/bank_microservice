{
  "info": {
    "name": "Bank Microservices - auth-service",
    "description": "Register, login, and call the protected /me endpoint against auth-service. Works either directly (port 8081) or through the api-gateway (port 8080) by changing the base_url variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8081/api/auth",
      "description": "Swap to http://localhost:8080/api/auth to go through api-gateway instead"
    },
    {
      "key": "auth_token",
      "value": "",
      "description": "Auto-filled by the Login request's Tests script"
    }
  ],
  "item": [
    {
      "name": "Register",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"jane\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/register",
          "host": ["{{base_url}}"],
          "path": ["register"]
        },
        "description": "Creates a new ROLE_CUSTOMER user and returns a JWT. Change the username/email if you've already registered 'jane' - usernames and emails are unique."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('auth_token', body.token);",
              "    console.log('Saved auth_token from register response');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Login",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"jane\",\n  \"password\": \"password123\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": ["{{base_url}}"],
          "path": ["login"]
        },
        "description": "Returns a fresh JWT for an existing user."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "    const body = pm.response.json();",
              "    pm.collectionVariables.set('auth_token', body.token);",
              "    console.log('Saved auth_token from login response');",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "Me (protected)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{auth_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/me",
          "host": ["{{base_url}}"],
          "path": ["me"]
        },
        "description": "Proves the JWT round-trip works. Run Register or Login first - this reads the token they saved into the auth_token collection variable automatically."
      }
    }
  ]
}
